{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/api/og-listings",
      "destination": "/api/og-listings"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

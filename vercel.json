{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" },
    {
      "rewrites": [
        {
          "source": "/sitemap.xml",
          "destination": "/api/sitemap.xml"
        },
        {
          "source": "/((?!api).*)",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
